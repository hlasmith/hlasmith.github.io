{
  "_comment": "Goes in your repo root as .lighthouserc.json (note the leading dot). Lighthouse serves your static files and tests every HTML page it finds. Thresholds are deliberately generous to avoid false failures; tighten over time.",
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "color-contrast": "error",
        "image-alt": "error",
        "document-title": "error",
        "meta-description": "error",
        "link-name": "error",
        "heading-order": "warn",
        "canonical": "warn"
      }
    }
  }
}
